# =============================================================================
# Dark Pattern Guardian — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env itself.
# See docs/07_PRIVACY_SECURITY.md for the full secrets policy.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# CORS (comma-separated origins for browser extension and dev frontends)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# OpenAI / LLM Configuration (Phase 4)
# ---------------------------------------------------------------------------
# SECURITY: The API key is loaded by the backend process ONLY.
# It is NEVER sent to the browser extension, frontend bundle, API responses,
# or logged. Keep it in .env or a secret manager — never commit it.
#
# If the key is empty or missing, the backend falls back to deterministic-only
# analysis (all Phase 2-3 features work without AI).

# Your OpenAI API key (required for AI interpretation)
OPENAI_API_KEY=

# Backward-compatible alias (used if OPENAI_API_KEY is not set)
# LLM_API_KEY=

# Model to use (default: gpt-4o-mini — fast, low cost, good for structured JSON)
# Alternatives: gpt-4o (higher quality, higher cost/latency)
OPENAI_MODEL=gpt-4o-mini

# Chat completions endpoint URL
# Override for Azure OpenAI, local proxies, or compatible providers:
#   Azure: https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-15-preview
#   Local: http://localhost:11434/v1/chat/completions
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Per-request timeout in seconds (default: 10)
OPENAI_TIMEOUT_S=10

# Maximum retry attempts on transient failures (429, 5xx). (default: 1, max: 3)
# Set to 0 to disable retries entirely.
OPENAI_MAX_RETRIES=1

# Maximum page-text characters sent to the LLM (default: 10000)
# Higher values increase cost and latency. Lower values may miss context.
LLM_MAX_TEXT_CHARS=10000

# ---------------------------------------------------------------------------
# Independent AI proposal provider (opt-in; only /api/v1/analyze/compare)
# ---------------------------------------------------------------------------
# "none" keeps the proposal pathway offline/unconfigured (default).
# Set to "ollama" only after the local Ollama service and model are available.
AI_PROPOSAL_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Cost Considerations
# ---------------------------------------------------------------------------
# gpt-4o-mini:  ~$0.15 / 1M input tokens, ~$0.60 / 1M output tokens
# gpt-4o:       ~$2.50 / 1M input tokens, ~$10.00 / 1M output tokens
#
# With default settings (10K chars ≈ 2.5K tokens), each analysis costs:
#   gpt-4o-mini: ~$0.0004 per request
#   gpt-4o:      ~$0.006 per request
#
# The deterministic pipeline runs first regardless, so disabling AI
# (by leaving OPENAI_API_KEY empty) has zero cost impact.
